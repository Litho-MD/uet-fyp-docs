@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Author / Client|
start
:Invoke build operation;
note right
    Entry points:
    CLI, VS Code, Web App,
    MCP Server, Hosted API
end note

|Build Service|
:Receive Markdown and template ID;
:Parse and validate Markdown;
if (Markdown valid?) then (yes)
    :Load template manifest and schema;
    if (Template found and compatible?) then (yes)
        :Bind AST to template;
        |LaTeX Generator|
        :Generate LaTeX source;
        if (Generation successful?) then (yes)
            |Isolated Build Environment|
            :Start sandboxed Tectonic compilation;
            if (Compilation successful?) then (yes)
                |PDF Metadata Processor|
                :Embed original Markdown source and provenance;
                |Build Service|
                :Produce compiled PDF artifact;
            else (no)
                |Build Service|
                :Collect Tectonic diagnostics;
            endif
        else (no)
            |Build Service|
            :Collect LaTeX generation diagnostics;
        endif
    else (no)
        |Build Service|
        :Collect template resolution diagnostics;
    endif
else (no)
    |Build Service|
    :Collect Markdown validation diagnostics;
endif

|Build Service|
:Return PDF artifact and build diagnostics;

|Author / Client|
:Receive build output;
stop
@enduml
