@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Author|
start
:Run litho init;
:Confirm project directory;

|Litho CLI|
:Detect project directory;
if (Directory valid and available?) then (yes)
    |Author|
    :Select or confirm template;

    |Litho CLI|
    :Resolve selected template;
    if (Template found?) then (yes)
        |Template Validator|
        :Validate template package;
        if (Template valid?) then (yes)
            |Litho CLI|
            :Create project configuration;
            :Create starter Markdown file;
            :Create required directories;
            :Display initialization success;
        else (no)
            |Litho CLI|
            :Report template validation errors;
        endif
    else (no)
        |Litho CLI|
        :Report template not found;
    endif
else (no)
    :Report invalid or existing project directory;
endif

stop
@enduml
