@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}

|AI Assistant|
start
:Send JSON-RPC tool call request;

|MCP Server|
:Receive tool request and arguments;
if (Tool supported and arguments valid?) then (yes)
    :Resolve template context and configuration;
    if (Required context available?) then (yes)
        |Litho Engine|
        :Execute requested tool operation\n(build, validate, template ops, extract);
        if (Operation completed successfully?) then (yes)
            :Produce operation result or artifact;
        else (no)
            :Produce service execution error;
        endif
        |MCP Server|
        :Format structured JSON-RPC response;
    else (no)
        |MCP Server|
        :Format context resolution error response;
    endif
else (no)
    |MCP Server|
    :Format schema validation error response;
endif

|MCP Server|
:Send JSON-RPC response to caller;

|AI Assistant|
:Receive JSON-RPC response;
:Process tool execution result;
stop
@enduml
