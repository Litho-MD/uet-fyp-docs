@startuml
hide empty description

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam stateBorderThickness 1
skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
}

state c_ready_in <<choice>>

[*] -down-> Idle : Start MCP Server

Idle -down-> Initializing : Client Connects
Initializing -down-> c_ready_in : Register Tools
c_ready_in -down-> Ready

state c_ready <<choice>>
Ready -down-> c_ready

c_ready -right-> ContextLoading : Tool Invoked
c_ready -left-> Shutdown : Disconnect

state c_ctx <<choice>>
ContextLoading -down-> c_ctx
c_ctx -left-> c_ready_in : Context Error
c_ctx -down-> Executing : Context Ready

Executing -down-> Formatting : Process Tool Call
Formatting -left-> c_ready_in : Return Result

Shutdown -down-> [*]

@enduml