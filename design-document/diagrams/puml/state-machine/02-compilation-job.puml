@startuml
hide empty description

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam stateBorderThickness 1
skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
}

[*] -down-> Queued : New Job

Queued -down-> Parsing : Scan Source

state c_parse <<choice>>
state c_failed_in <<choice>>

Parsing -down-> c_parse
c_parse -right-> c_failed_in : Syntax Error
c_parse -down-> Validating : AST Ready

state c_val <<choice>>
Validating -down-> c_val
c_val -right-> c_failed_in : Schema Error
c_val -down-> Binding : AST Valid

Binding -down-> Generating : Bind Template
Generating -down-> Compiling : LaTeX Ready

state c_comp <<choice>>
Compiling -down-> c_comp
c_comp -right-> c_failed_in : Build Error
c_comp -down-> Embedding : XeTeX Success

c_failed_in -down-> Failed

Embedding -down-> Completed : Metadata Injected

Completed -down-> [*] : Deliver PDF
Failed -down-> [*] : Diagnostics

@enduml