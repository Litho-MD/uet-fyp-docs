---
config:
  theme: redux
  look: classic
---
flowchart TD
    A([Start]) --> B[Open conversion workspace]
    B --> M_input{" "}
    M_input --> C[Enter or upload Markdown]
    C --> D[Select template]
    D --> E[Click Generate PDF]
    E --> F{Is the document valid?}

    F -- No --> G[Display validation errors]
    G --> M_input

    F -- Yes --> H[Compile document]
    H --> I{Compilation successful?}

    I -- No --> J[Display compilation errors]
    J --> M_input

    I -- Yes --> K[Preview generated PDF]
    K --> L[Download PDF]
    L --> M([End])
