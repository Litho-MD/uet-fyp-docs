---
config:
  theme: redux
  look: classic
---
flowchart TD
    A([Start]) --> B[Install Litho CLI]
    B --> C[Run litho init]
    C --> M_edit{" "}
    M_edit --> D[Create or edit Markdown file]
    D --> E[Choose template]
    E --> M_build{" "}
    M_build --> F[Run litho build]
    F --> G{Command valid?}

    G -- No --> H[Display command error]
    H --> M_build

    G -- Yes --> I{Markdown valid?}
    I -- No --> J[Display validation errors]
    J --> M_edit

    I -- Yes --> K[Generate LaTeX]
    K --> L[Compile PDF]
    L --> M{Compilation successful?}

    M -- No --> N[Display compilation errors]
    N --> M_edit

    M -- Yes --> O[Save PDF]
    O --> P([End])
