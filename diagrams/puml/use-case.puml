@startuml
left to right direction
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam ArrowColor black
skinparam defaultFontColor black

skinparam actor {
    BackgroundColor white
    BorderColor black
    FontColor black
}

skinparam usecase {
    BackgroundColor white
    BorderColor black
    FontColor black
}

skinparam package {
    BackgroundColor white
    BorderColor black
    FontColor black
}

actor "Author / Student" as Author
actor "Template Publisher" as Publisher
actor "Maintainer" as Maintainer
actor "AI Assistant" as AIAssistant
actor "CMS / External Client" as CMS

rectangle "Litho Publishing Ecosystem" {
    package "Document Authoring & Compilation" {
        usecase "UC-01: Build PDF Locally" as UC01
        usecase "UC-02: Edit Markdown with Diagnostics" as UC02
        usecase "UC-03: Watch & Hot-Rebuild" as UC03
        usecase "UC-04: Restore Source from PDF" as UC04
        usecase "UC-07: Convert in Web Application" as UC07
        usecase "Select Template" as UC_SelTemp
        usecase "Embed Metadata" as UC_Embed
        usecase "Display Diagnostics" as UC_Errors
    }

    package "Marketplace & Community" {
        usecase "UC-05: Browse & Inspect Templates" as UC05
        usecase "UC-06: React & Download Template" as UC06
        usecase "UC-14: Review & Publish Listing" as UC14
    }

    package "Template Engineering" {
        usecase "UC-09: Create Template Package" as UC09
        usecase "UC-10: Validate Template Package" as UC10
        usecase "UC-11: Submit Template via GitHub" as UC11
    }

    package "AI & Autonomous Workflows" {
        usecase "UC-08: Convert Specification (AI)" as UC08
        usecase "UC-12: Generate Template (AI)" as UC12
        usecase "UC-13: Automated Security Review" as UC13
    }

    package "Programmatic Interfaces (MCP & API)" {
        usecase "UC-15: Invoke Litho via MCP" as UC15
        usecase "UC-16: Automated Export via Webhook" as UC16
        usecase "UC-17: Restore Source via API" as UC17
    }
}

' Author relations
Author --> UC01
Author --> UC02
Author --> UC03
Author --> UC04
Author --> UC05
Author --> UC07
Author --> UC08

UC01 ..> UC_SelTemp : <<include>>
UC01 ..> UC_Embed : <<include>>
UC01 ..> UC_Errors : <<extend>>
UC05 ..> UC06 : <<extend>>

' Publisher relations
Publisher --> UC09
Publisher --> UC10
Publisher --> UC11
Publisher --> UC12

UC11 ..> UC10 : <<include>>
UC12 ..> UC13 : <<include>>

' Maintainer relations
Maintainer --> UC14

' AI Assistant relations
AIAssistant --> UC15

' CMS relations
CMS --> UC16
CMS --> UC17

@enduml
