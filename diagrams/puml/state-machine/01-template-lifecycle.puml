@startuml STATE-01-template-lifecycle
title STATE-01 - Template Package Lifecycle

hide empty description

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam stateBorderThickness 1
skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
}

state c_draft_in <<choice>>

[*] -down-> c_draft_in
c_draft_in -down-> Draft

Draft -down-> Validating : Validate

state c_val <<choice>>
Validating -down-> c_val
c_val -left-> c_draft_in : Validation Error
c_val -down-> Packaged : Manifest Valid

Packaged -down-> Submitted : Submit Issue
Submitted -down-> Scanning : Trigger Webhook

state c_scan <<choice>>
Scanning -down-> c_scan
c_scan -left-> c_draft_in : Scan Failed
c_scan -down-> UnderReview : Scan Passed

state c_rev <<choice>>
UnderReview -down-> c_rev
c_rev -left-> c_draft_in : Changes Requested
c_rev -down-> Listed : Approved

state c_list <<choice>>
state c_withdrawn_in <<choice>>

Listed -down-> c_list
c_list -down-> Deprecated : Deprecate
c_list -right-> c_withdrawn_in : Delist

Deprecated -down-> c_withdrawn_in : Retire
c_withdrawn_in -down-> Withdrawn
Withdrawn -down-> [*]
Draft -right-> [*] : Delete

@enduml