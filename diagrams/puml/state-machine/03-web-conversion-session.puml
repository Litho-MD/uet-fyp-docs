@startuml STATE-03-web-conversion-session
title STATE-03 - Web Conversion Workspace Session

hide empty description

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam stateBorderThickness 1
skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
}

state c_ready_in <<choice>>
state c_edit_in <<choice>>

[*] -down-> c_ready_in : Open Web Workspace
c_ready_in -down-> Ready

state c_action <<choice>>
Ready -down-> c_action

c_action -down-> c_edit_in : Enter Markdown
c_action -right-> Restoring : Upload PDF

state c_restore <<choice>>
Restoring -down-> c_restore
c_restore -left-> c_edit_in : Source Extracted
c_restore -up-> c_ready_in : Extraction Error

c_edit_in -down-> Editing
Editing -down-> Compiling : Convert to PDF

state c_compile <<choice>>
Compiling -down-> c_compile
c_compile -left-> c_edit_in : Compilation Error
c_compile -down-> Preview : Build Success

state c_preview <<choice>>
Preview -down-> c_preview
c_preview -left-> Downloading : Click Download
Downloading -up-> Preview : File Saved
c_preview -up-> c_edit_in : Edit Content
c_preview -up-> c_ready_in : Reset Session

Ready -left-> [*] : Close Session

@enduml