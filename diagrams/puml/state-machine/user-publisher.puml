@startuml state-user-publisher
title User: Publisher

hide empty description

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 0
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam stateBorderThickness 1
skinparam state {
    BackgroundColor white
    BorderColor black
    FontColor black
}

state c_start <<choice>>
state "Open Workspace" as open_ws
state c_auth <<choice>>
state c_menu <<choice>>
state "Exit" as exit_ws

[*] --> c_start
c_start --> open_ws
open_ws --> c_auth
c_auth --> c_menu : Ready
c_auth --> c_start : Retry

c_menu --> exit_ws : Exit
exit_ws --> [*]

' Section 1: Template Authoring
state "Template Authoring" as feat1
state c_f1 <<choice>>
state "Configure Manifest" as f1_1
state "Author Macros" as f1_2
state "Define Schema" as f1_3
state c_f1_m <<choice>>

c_menu --> feat1
feat1 --> c_f1
c_f1 --> f1_1
c_f1 --> f1_2
c_f1 --> f1_3
f1_1 --> c_f1_m
f1_2 --> c_f1_m
f1_3 --> c_f1_m

' Section 2: Local Validation
state "Local Validation" as feat2
state c_f2 <<choice>>
state "Run Validation" as f2_1
state "Fix Schema Errors" as f2_2
state "Package Tarball" as f2_3
state c_f2_m <<choice>>

c_f1_m --> feat2
feat2 --> c_f2
c_f2 --> f2_1
c_f2 --> f2_2
c_f2 --> f2_3
f2_1 --> c_f2_m
f2_2 --> c_f2_m
f2_3 --> c_f2_m

' Section 3: GitHub Submission
state "GitHub Submission" as feat3
state c_f3 <<choice>>
state "Submit Issue" as f3_1
state "Run Security Scan" as f3_2
state "Review Diagnostics" as f3_3
state c_f3_m <<choice>>

c_f2_m --> feat3
feat3 --> c_f3
c_f3 --> f3_1
c_f3 --> f3_2
c_f3 --> f3_3
f3_1 --> c_f3_m
f3_2 --> c_f3_m
f3_3 --> c_f3_m

c_f3_m --> c_menu : Return to Menu

@enduml