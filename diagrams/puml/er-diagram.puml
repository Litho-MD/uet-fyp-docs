@startuml er-diagram
!theme plain
title Litho Marketplace Registry and Engagement Data Model

entity "GitHub Issue\n(registry entry)" as issue {
  *number : int <<PK>>
  --
  title : varchar(255)
  author : varchar(64)
  state : enum(open, closed)
  labels : set<varchar>
  submitted_at : timestamp
}

entity "Template Manifest" as manifest {
  *id : varchar(64) <<PK>>
  --
  issue_number : int <<FK>>
  name : varchar(255)
  version : varchar(32)
  schema : json
  skills_md : text
  repository_url : varchar(512)
}

entity "Template Release" as release {
  *tag : varchar(64) <<PK>>
  --
  issue_number : int <<FK>>
  version : varchar(32)
  changelog : text
  published_at : timestamp
}

entity "Template Asset" as asset {
  *path : varchar(512) <<PK>>
  --
  release_tag : varchar(64) <<FK>>
  type : varchar(50)
}

entity "Template Counters" as counters {
  *template_id : varchar(64) <<PK, FK>>
  --
  hearts : int
  downloads : int
  updated_at : timestamp
}

issue ||--|| manifest : describes
issue ||--o{ release : lists
release ||--o{ asset : contains
manifest ||--|| counters : tracks
@enduml
