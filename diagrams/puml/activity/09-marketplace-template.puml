@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Author|
start
:Open Litho marketplace;

|Marketplace|
:Connect to approved template registry;
if (GitHub registry available?) then (yes)
    :Load approved template listings;
    |Author|
    :Search or filter templates;

    |Marketplace|
    :Retrieve matching listings;
    if (Matching templates found?) then (yes)
        :Display matching templates;
        |Author|
        :Open template details;

        |Marketplace|
        if (Template details available?) then (yes)
            :Display description, manifest, license, and counts;
            if (Preview asset available?) then (yes)
                :Display template preview;
            else (no)
                :Display preview unavailable;
            endif

            if (Requested version available?) then (yes)
                :Provide selected template package;
                :Increment download count when applicable;
                |Author|
                :Start local or web conversion workflow;
                :Use selected template;
            else (no)
                :Report template version unavailable;
            endif
        else (no)
            :Report unavailable template details;
        endif
    else (no)
        :Display no matching templates;
    endif
else (no)
    :Report registry unavailable;
endif

stop
@enduml
