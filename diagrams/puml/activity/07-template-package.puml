@startuml
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Template Publisher|
start
:Run template creation command;

|Template CLI|
:Create or load package structure;

|Template Publisher|
:Provide manifest.json;
:Provide schema.json;
:Provide template resources;
:Provide assets;
:Provide README documentation;
:Provide license information;
:Provide compatibility metadata;

|Package Validator|
:Parse package JSON files;
if (JSON valid?) then (yes)
else (no)
    :Report invalid JSON;
    stop
endif

:Validate required manifest fields;
if (Manifest complete?) then (yes)
else (no)
    :Report missing manifest field;
    stop
endif

:Validate schema fields and constraints;
if (Schema valid?) then (yes)
else (no)
    :Report invalid schema;
    stop
endif

:Check referenced assets;
if (All assets available?) then (yes)
else (no)
    :Report missing asset;
    stop
endif

:Validate package dependencies;
if (Dependencies supported?) then (yes)
else (no)
    :Report unsupported dependency;
    stop
endif

:Validate license information;
if (License valid?) then (yes)
else (no)
    :Report invalid license;
    stop
endif

:Check engine compatibility;
if (Engine compatible?) then (yes)
else (no)
    :Report incompatible engine version;
    stop
endif

:Inspect package execution restrictions;
if (Forbidden macro or shell execution?) then (yes)
    :Reject arbitrary execution;
    :Report package security violation;
    stop
else (no)
    :Confirm declarative restrictions;
endif

|Template CLI|
:Display validation results;
:Mark package ready for publication;
stop
@enduml