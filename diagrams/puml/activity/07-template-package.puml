@startuml
title ACT-07 - Create and Validate a Template Package

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Template Publisher|
start
:Run template creation command;

|Template CLI|
:Create or load package structure;

|Template Publisher|
:Provide manifest.json, schema, templates, and docs;

|Package Validator|
:Parse package JSON files;
if (JSON valid?) then (yes)
    :Validate manifest and schema constraints;
    if (Manifest and schema valid?) then (yes)
        :Inspect package assets and dependencies;
        if (Assets and dependencies valid?) then (yes)
            :Inspect execution restrictions;
            if (Forbidden execution detected?) then (no)
                |Template CLI|
                :Mark package ready for publication;
            else (yes)
                |Template CLI|
                :Report package security violation;
            endif
        else (no)
            |Template CLI|
            :Report missing asset or dependency error;
        endif
    else (no)
        |Template CLI|
        :Report manifest or schema error;
    endif
else (no)
    |Template CLI|
    :Report invalid JSON syntax;
endif

|Template CLI|
:Display validation results and diagnostics;
stop
@enduml
