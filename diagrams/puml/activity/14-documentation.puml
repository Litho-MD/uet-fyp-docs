@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Documentation Maintainer|
start
:Update documentation;
note right
    Documentation categories:
    Installation, configuration,
    usage, CLI, template publishing,
    API and MCP guidance
end note
:Push changes to repository;

|CI/CD System|
:Detect documentation changes;
:Start documentation build;
:Build documentation website;
if (Build successful and quality checks passed?) then (yes)
    :Approve documentation build;
    :Publish versioned documentation website;
    if (Deployment successful?) then (yes)
        :Mark documentation release successful;
        |Documentation User|
        :Visit documentation website;
        :Select documentation category;
        :Read relevant guidance;
    else (no)
        :Report deployment failure;
    endif
else (no)
    :Report documentation build or validation failure;
endif

stop
@enduml
