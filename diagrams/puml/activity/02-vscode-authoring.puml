@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Author|
start
:Open Markdown file in VS Code;

|VS Code Extension|
:Detect document type;
if (Litho document?) then (yes)
    :Load core Litho grammar;
    :Load selected template manifest;
    if (Manifest available?) then (yes)
        :Load template schema;
        :Enable syntax highlighting;
        :Load authoring snippets;
        :Provide core and shortcode IntelliSense;
    else (no)
        :Report missing template manifest;
        :Provide core authoring features only;
    endif

    |Author|
    :Edit Litho Markdown document;

    |VS Code Extension|
    :Analyze document syntax;
    if (Syntax valid?) then (yes)
        :Validate template-defined constructs;
    else (no)
        :Display syntax diagnostics;
    endif

    :Refresh editor assistance;
else (no)
    :Treat as standard text file;
endif

stop
@enduml
