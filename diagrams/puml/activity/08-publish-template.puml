@startuml
title ACT-08 - Submit and Publish a Template through GitHub

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Template Publisher|
start
:Validate template package;
if (Package validation passed?) then (yes)
    repeat
        |Template Publisher|
        :Submit package through GitHub Issue;

        |GitHub|
        if (GitHub service reachable?) then (yes)
            :Record issue and repository information;

            |Marketplace / Maintainer|
            if (Repository and manifest accessible?) then (yes)
                :Receive template submission;
                :Inspect package metadata and assets;
                :Evaluate submission against baseline;

                |Maintainer|
                if (Submission approved?) then (approved)
                    :Apply approved-and-verified label;
                else (remediation needed)
                    if (Submission rejected permanently?) then (rejected)
                        :Record rejection reason;
                    else (changes requested)
                        :Request package changes;
                        |Template Publisher|
                        :Update template package;
                        :Push revision commits;
                    endif
                endif
            else (no)
                :Report repository or manifest unavailable;
            endif
        else (no)
            :Report GitHub connection failure;
        endif
    repeat while (Revision submitted?) is (yes) not (no)

    |Marketplace|
    if (Submission labeled approved-and-verified?) then (yes)
        :Resolve template manifest and previews;
        if (Listing resources ready?) then (yes)
            :Publish marketplace listing;
        else (no)
            :Report listing resource failure;
        endif
    else (no)
        :Archive submission issue;
    endif
else (no)
    :Display package validation errors;
endif

stop
@enduml
