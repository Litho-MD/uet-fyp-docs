@startuml
title ACT-11 - Use AI-Assisted Authoring

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam ArrowColor black
skinparam defaultFontColor black
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}

|Author|
start
:Open AI authoring feature;
:Select AI operation;
:Provide initial prompt or source material;
note right
    Supported inputs:
    Specification, Markdown document,
    template modification request,
    or template generation prompt
end note

|AI Authoring Service|
if (Operation supported?) then (yes)
    :Load product-level skills.md;
    :Load curated template dataset;

    if (Template context required?) then (yes)
        :Load selected template manifest;
    else (no)
        :Continue with standard context;
    endif

    repeat
        |AI Authoring Service|
        :Prepare AI generation context;
        :Generate proposed output;
        :Validate generated result;

        if (Validation passed?) then (yes)
            :Prepare output preview;
            |Author|
            :Review preview;
        else (no)
            :Display validation diagnostics;
            |Author|
            :Refine prompt or adjust constraints;
        endif
    repeat while (Author accepts result?) is (no) not (yes)

    |AI Authoring Service|
    if (Accepted result is a template package?) then (yes)
        :Send package to template validation;
        :Prepare for publication workflow;
    else (no)
        :Return accepted Markdown or document;
    endif
else (no)
    :Report unsupported operation error;
endif

stop
@enduml
