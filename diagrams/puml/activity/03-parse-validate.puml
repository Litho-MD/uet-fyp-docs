@startuml
title ACT-03 - Tokenize, Parse, and Validate Litho Markdown

skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultTextAlignment center
skinparam activityBorderThickness 1
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam ArrowColor black
skinparam defaultFontColor black

|Author / Calling Tool|
start
:Provide Litho Markdown source;

|Tokenizer|
:Scan Markdown source;
:Generate lexical tokens;
if (Lexical errors found?) then (no)
    |Parser|
    :Parse token stream;
    :Construct abstract syntax tree (AST);
    if (Syntax errors found?) then (no)
        |Validation Engine|
        :Validate frontmatter and schema fields;
        if (Frontmatter and fields valid?) then (yes)
            :Validate template-defined constructs;
            if (Template constructs valid?) then (yes)
                |Litho System|
                :Return validated AST;
            else (no)
                |Litho System|
                :Report construct validation errors;
            endif
        else (no)
            |Litho System|
            :Report frontmatter or schema errors;
        endif
    else (yes)
        |Litho System|
        :Collect syntax diagnostics;
    endif
else (yes)
    |Litho System|
    :Collect lexical diagnostics;
endif

|Litho System|
:Return processing result and diagnostics;
stop
@enduml
