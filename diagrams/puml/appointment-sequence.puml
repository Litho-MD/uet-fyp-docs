@startuml
actor Student
participant "Web Client" as Client
participant "Appointment Service" as Service
database "Appointment DB" as DB
participant "Notification Service" as Notify

Student -> Client: Select slot and submit request
activate Client
Client -> Service: createAppointment(studentId, slotId)
activate Service
Service -> DB: Check slot availability
activate DB
DB --> Service: Available / unavailable
deactivate DB

alt Slot is available
    Service -> DB: Save appointment
    DB --> Service: Appointment created
    Service -> Notify: Send confirmation
    alt Notification succeeds
        Notify --> Service: Confirmation sent
    else Notification fails
        Notify --> Service: Delivery error
        Service -> DB: Record notification retry
    end
    Service --> Client: Return confirmed appointment
    Client --> Student: Display confirmation
else Slot is unavailable
    Service --> Client: Return conflict error
    Client --> Student: Suggest another slot
end

deactivate Service
deactivate Client
@enduml
